# ==============================================================================
# DokanSaathi Environment Configuration Template (.env.example)
# Copy this file to .env.local and populate with your real credentials.
# NEVER commit .env or .env.local to source control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Authentication & PostgreSQL Configuration
# ------------------------------------------------------------------------------
# Public Supabase Project URL (safe for client bundle)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public Supabase Anon Key (safe for client bundle, protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-Only Supabase Service Role Key (NEVER expose to client or prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 2. AI Runtime Extraction Provider
# ------------------------------------------------------------------------------
# Active AI Provider: "mock" (default for offline dev & test), "gemini", or "openai"
AI_PROVIDER=mock

# Server-Only AI Provider API Key (Required only if AI_PROVIDER is "gemini" or "openai")
AI_API_KEY=your-ai-provider-api-key

# Optional Model Name
AI_MODEL_NAME=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 3. Speech-to-Text Transcription Provider
# ------------------------------------------------------------------------------
# Active Speech Provider: "mock" (default for testing), "whisper", or "deepgram"
SPEECH_PROVIDER=mock

# Server-Only Speech Provider API Key
SPEECH_API_KEY=your-speech-provider-api-key

# ------------------------------------------------------------------------------
# 4. Application Host
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
